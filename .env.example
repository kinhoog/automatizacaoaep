AEP_HOST=127.0.0.1
AEP_PORT=8000
AEP_ALLOWED_ORIGINS=http://127.0.0.1:8000
# Apenas para desenvolvimento local. A hospedagem deve manter true.
AEP_REQUIRE_ORIGIN=false
AEP_MAX_FILE_MB=25
AEP_MAX_REQUEST_MB=250
AEP_RUNTIME_DIR=uploads
AEP_JOB_TTL_MINUTES=15
AEP_JOB_TTL_SECONDS=900
AEP_TEMPLATE_PATH=private_templates/aep_template.docx
AEP_TEMPLATE_MANIFEST_PATH=private_templates/aep_template.manifest.json
# Somente testes sintéticos públicos; mantenha false em uso real.
AEP_ALLOW_SYNTHETIC_TEMPLATE_FALLBACK=false
AEP_COMPATIBILITY_PROFILE_PATH=private_templates/aep_compatibility_profile.json
AEP_RENDER_ON_GENERATE=false
AEP_LIBREOFFICE_PATH=
# Na hospedagem, aponte para secret files Base64 privados. Não cole o conteúdo aqui.
AEP_HOSTED_TEMPLATE_BASE64_FILE=
AEP_HOSTED_TEMPLATE_MANIFEST_BASE64_FILE=
AEP_HOSTED_COMPATIBILITY_PROFILE_BASE64_FILE=
